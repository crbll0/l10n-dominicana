<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
                <t t-if="receipt.l10n_latam_document_type and receipt.l10n_latam_document_number">
                	<br/>
                    <div class="pos-receipt-center-align dotted_ticket_title">
                        <strong>Factura de
                            <t t-esc="receipt.l10n_latam_document_type.name"/>
                        </strong>
                        <br/>
                        <strong>NCF:
                            <t t-esc="receipt.l10n_latam_document_number"/>
                        </strong>
                        <t t-if="receipt.l10n_do_is_return_order">
                            <br/>
                            <strong>NCF Modificado:
                                <t t-esc="receipt.l10n_do_origin_ncf"/>
                            </strong>
                        </t>
                        <t t-if="receipt.l10n_do_ncf_expiration_date">
                            <br/>
                            <strong>Válida hasta:
                                <t t-esc="receipt.l10n_do_ncf_expiration_date"/>
                            </strong>
                        </t>
                    </div>
                </t>
                <br/>
                <div class="receipt-phone">
                    <strong>Fecha....:</strong>
                    <t t-esc="receipt.formatted_validation_date"/>
                    <br/>
                     <t t-set="client" t-value="env.pos.get_client()"/>
                    <t t-if="client">
                        <strong>Cliente..:</strong>
                        <t t-esc="client.name || ''"/>
                        <br/>
                        <t t-if="client.vat">
                            <strong>RNC/Céd..:</strong>
                            <t t-esc="client.vat"/>
                            <br/>
                        </t>
                        <t t-if="client.barcode">
                            <strong>Código..:</strong>
                            <t t-esc="client.barcode"/>
                            <br/>
                        </t>
                    </t>
                    <!--TODO: What is this field?-->
                    <!--<strong>Sucursal.:</strong>-->
                    <!--<t t-esc="receipt.shop.name"/>-->
                    <!--<br/>-->
                    <strong>Telefono.:</strong>
                    <t t-esc="env.pos.company.phone || ''"/>
                    <br/>
                </div>
        </xpath>
    </t>
</templates>
